[Unit]
Description=RCP Lab local web interface and evolution worker
After=network.target rcp-model.service
Wants=rcp-model.service

[Service]
User=rcp-lab
Group=rcp-lab
WorkingDirectory=/opt/rcp-lab
EnvironmentFile=/etc/rcp-lab.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/rcp-lab/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8765 --workers 1
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=15
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rcp-lab
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=1G
CPUQuota=200%
TasksMax=128
LimitNOFILE=256
LimitCORE=0

[Install]
WantedBy=multi-user.target
